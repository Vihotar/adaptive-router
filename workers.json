{
  "workers": [
    {
      "id": "codex",
      "enabled": true,
      "roles": [
        "plan",
        "build",
        "review"
      ],
      "priority": 10,
      "adapter": "codex"
    },
    {
      "id": "antigravity",
      "enabled": true,
      "roles": [
        "review",
        "build"
      ],
      "priority": 30,
      "adapter": "antigravity"
    },
    {
      "id": "claude-code",
      "enabled": false,
      "roles": [
        "build",
        "review"
      ],
      "priority": 20,
      "adapter": "claude"
    },
    {
      "id": "cline",
      "enabled": false,
      "roles": [
        "build"
      ],
      "priority": 35,
      "adapter": "cline",
      "providerOrder": [
        "gemini",
        "nvidia",
        "openrouter"
      ]
    }
  ],
  "maxCorrections": 2,
  "workerTimeoutSeconds": 600,
  "claudeReserve": true,
  "connectorToken": "CONNECTOR_TOKEN_REGENERATED_ON_FIRST_RUN",
  "reviewPolicy": "independent"
}
