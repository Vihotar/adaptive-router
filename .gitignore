# Adaptive Router — .gitignore

# Runtime state (generated by the router — never commit task data)
.router/

# Downloaded tools (e.g. agy.exe bundled locally)
.tools/

# Node.js dependencies (no npm deps at present, but included for completeness)
node_modules/

# Log files
*.log

# Machine-specific browser test configuration (auto-generated by setup)
browser-runtime.json

# Environment files (should never be committed)
.env
.env.*
!.env.example
.env.local
.env.development
.env.production

# Connector tokens and secrets
.connector-token*
*.token

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/settings.json
*.swp
*.swo
